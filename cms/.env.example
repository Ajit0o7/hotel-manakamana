# Copy to .env (never commit it) or set these in your host's dashboard.

# Supabase → Project Settings → Database → Connection string.
# Use the direct connection or the session pooler (port 5432). The transaction
# pooler (port 6543) also works.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# A secret key (sb_secret_...) or the legacy service_role key. Server-side only!
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only needed if your project still signs user tokens with the legacy JWT
# secret (HS256). Projects using JWT signing keys are verified through JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=media

# app_metadata.cms_role values that may use the admin API (comma-separated).
CMS_ALLOWED_ROLES=admin

# Browser origins allowed to call the API (your Vercel domains, the admin UI).
CORS_ALLOWED_ORIGINS=https://www.hotelmanthali.com,http://localhost:3000

# Public website origin: default canonical URLs, internal-link detection.
SITE_URL=https://www.hotelmanthali.com

MAX_UPLOAD_MB=50
PORT=8080
LOG_LEVEL=info

# Optional: extra content types defined in JSON (see examples/content-types.json).
# CONTENT_TYPES_FILE=examples/content-types.json
