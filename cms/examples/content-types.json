[
  {
    "name": "activity",
    "label": "Activity",
    "label_plural": "Things to do",
    "description": "Things to do around Manthali, shown on /things-to-do/<slug>.",
    "route_prefix": "/things-to-do",
    "sortable": true,
    "fields": [
      { "name": "distance", "label": "Distance from the hotel", "type": "text", "help": "e.g. \"15 minutes on foot\"." },
      { "name": "season", "label": "Best season", "type": "select", "options": ["all year", "spring", "monsoon", "autumn", "winter"] },
      { "name": "price_npr", "label": "Typical cost (NPR)", "type": "number" },
      { "name": "highlights", "label": "Highlights", "type": "list", "help": "One per item." },
      { "name": "photos", "label": "Photos", "type": "gallery" },
      {
        "name": "schedule", "label": "Schedule", "type": "table",
        "columns": [
          { "name": "time", "label": "Time", "type": "text" },
          { "name": "what", "label": "What happens", "type": "textarea" }
        ]
      },
      { "name": "booking_url", "label": "External booking link", "type": "url" }
    ]
  }
]
